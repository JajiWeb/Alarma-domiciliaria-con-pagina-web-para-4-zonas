// ===== Funciones =====
void manejarRaiz() {
  servidorWeb.send_P(200, "text/html", PAGINA_HTML);
}

void manejarEstado() {
  StaticJsonDocument<512> doc;
  JsonArray zonas = doc.createNestedArray("zonas");
  for (int i = 0; i < NUM_ZONAS; i++) {
    JsonObject z = zonas.createNestedObject();
    z["sensor"] = ultimaLectura[i];
    z["alarma"] = estadoZona[i];
    z["nombre"] = NOMBRE_ZONA[i];
  }
  String salida;
  serializeJson(doc, salida);
  servidorWeb.send(200, "application/json", salida);
}

void enviarEstadoWS() {
  StaticJsonDocument<512> doc;
  JsonArray zonas = doc.createNestedArray("zonas");
  for (int i = 0; i < NUM_ZONAS; i++) {
    JsonObject z = zonas.createNestedObject();
    z["sensor"] = ultimaLectura[i];
    z["alarma"] = estadoZona[i];
    z["nombre"] = NOMBRE_ZONA[i];
  }
  String salida;
  serializeJson(doc, salida);
  webSocket.broadcastTXT(salida);
}

void webSocketEvent(uint8_t num, WStype_t type, uint8_t * payload, size_t length) {
  if (type == WStype_CONNECTED) {
    Serial.printf("Cliente WS #%u conectado\n", num);
    enviarEstadoWS();
  } else if (type == WStype_DISCONNECTED) {
    Serial.printf("Cliente WS #%u desconectado\n", num);
  }
}

bool leerSensor(int i) {
  bool lectura = digitalRead(PIN_SENSOR[i]);
  if (lectura != ultimaLectura[i]) {
    if (millis() - tUltimoCambio[i] > TIEMPO_DEBOUNCE) {
      ultimaLectura[i] = lectura;
      tUltimoCambio[i] = millis();
    }
  }
  return ultimaLectura[i];
}

void activarAlarma(int i) {
  estadoZona[i] = true;
  tInicioAlarma[i] = millis();
  digitalWrite(PIN_SALIDA[i], HIGH);
  Serial.printf(">>> ALARMA en %s\n", NOMBRE_ZONA[i]);
  enviarEstadoWS();
}

void desactivarAlarma(int i) {
  estadoZona[i] = false;
  digitalWrite(PIN_SALIDA[i], LOW);
  Serial.printf("<<< Normalizada %s\n", NOMBRE_ZONA[i]);
  enviarEstadoWS();
}

void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("\n=== Sistema de Alarma ESP32 ===");

  // Configurar pines
  for (int i = 0; i < NUM_ZONAS; i++) {
    pinMode(PIN_SENSOR[i], INPUT_PULLUP);
    pinMode(PIN_SALIDA[i], OUTPUT);
    digitalWrite(PIN_SALIDA[i], LOW);
    ultimaLectura[i] = digitalRead(PIN_SENSOR[i]);
  }

  // Conectar WiFi
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Conectando WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\n✓ WiFi conectado");
  Serial.print("IP: ");
  Serial.println(WiFi.localIP());

  // Rutas HTTP
  servidorWeb.on("/", manejarRaiz);
  servidorWeb.on("/estado", manejarEstado);
  servidorWeb.begin();

  // WebSocket
  webSocket.begin();
  webSocket.onEvent(webSocketEvent);

  Serial.println("Servidor web iniciado en puerto 80");
  Serial.println("WebSocket en puerto 81");
}

void loop() {
  servidorWeb.handleClient();
  webSocket.loop();

  // Revisar cada zona
  for (int i = 0; i < NUM_ZONAS; i++) {
    bool lectura = leerSensor(i);

    if (lectura && !estadoZona[i]) {
      activarAlarma(i);
    }

    if (estadoZona[i] && (millis() - tInicioAlarma[i] >= TIEMPO_ALARMA)) {
      desactivarAlarma(i);
    }
  }

  // Enviar estado periódico (cada 1 segundo) para sincronizar
  static unsigned long ultimoEnvio = 0;
  if (millis() - ultimoEnvio > 1000) {
    enviarEstadoWS();
    ultimoEnvio = millis();
  }
}
