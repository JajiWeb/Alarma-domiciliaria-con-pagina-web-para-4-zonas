/*
 * Sistema de Alarma ESP32 con Interfaz Web
 * - 4 zonas con sensores digitales
 * - 4 salidas (LED/Relé) independientes
 * - Servidor web con WebSocket en tiempo real
 */

#include <WiFi.h>
#include <WebServer.h>
#include <WebSocketsServer.h>
#include <ArduinoJson.h>

// ===== Configuración WiFi =====
const char* WIFI_SSID     = "TU_WIFI";
const char* WIFI_PASSWORD = "TU_PASSWORD";

// ===== Definición de Zonas =====
#define NUM_ZONAS 4

const int PIN_SENSOR[NUM_ZONAS] = {4, 16, 17, 18};   // Entradas
const int PIN_SALIDA[NUM_ZONAS] = {5, 19, 21, 22};   // Salidas
const char* NOMBRE_ZONA[NUM_ZONAS] = {
  "Zona 1 - Entrada",
  "Zona 2 - Pasillo",
  "Zona 3 - Ventana",
  "Zona 4 - Garage"
};

// ===== Parámetros =====
const unsigned long TIEMPO_ALARMA   = 10000;  // ms que dura la alarma
const unsigned long TIEMPO_DEBOUNCE = 50;     // ms antirrebote

// ===== Variables de estado =====
bool estadoZona[NUM_ZONAS]         = {false};
bool ultimaLectura[NUM_ZONAS]      = {false};
unsigned long tInicioAlarma[NUM_ZONAS] = {0};
unsigned long tUltimoCambio[NUM_ZONAS] = {0};

// ===== Servidores =====
WebServer servidorWeb(80);
WebSocketsServer webSocket(81);

